[LL_WEBREPORT_EXCLUDEHTML /]

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Failed Documents - CLM Search Report</title>

    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 30px;
            background-color: #f4f6f9;
            color: #333;
        }

        .report-header {
            margin-bottom: 25px;
        }

        .report-header h2 {
            margin: 0 0 10px 0;
            color: #1a365d;
        }

        .report-header p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }

        .filter-info {
            margin-top: 10px;
            font-size: 14px;
            color: #444;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        th {
            background-color: #1a365d;
            color: #ffffff;
            text-align: left;
            padding: 14px 16px;
            font-size: 14px;
            text-transform: uppercase;
        }

        td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
        }

        tr:hover {
            background-color: #f8fafc;
        }

        .doc-id {
            font-family: monospace;
            font-weight: bold;
            color: #4a5568;
            background: #edf2f7;
            padding: 3px 6px;
            border-radius: 4px;
        }

        .action-link {
            color: #3182ce;
            text-decoration: none;
            font-weight: 600;
        }

        .action-link:hover {
            text-decoration: underline;
        }

        .search-again {
            margin-bottom: 20px;
        }

        .search-again button {
            background: #1a365d;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
        }
        
        .export-btn {
            background: #2f855a;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            margin-left: 10px;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

</head>

<body>

<div class="search-again">
    <form method="GET"
          action="cs.exe">
    
        <input type="hidden"
               name="func"
               value="ll">
    
        <input type="hidden"
               name="objId"
               value="35950584">
    
        <input type="hidden"
               name="objAction"
               value="RunReport">
    
        <button type="submit">
            Change Date Filter
        </button>
    
        <input type="hidden"
           name="InputLabel1"
           value="[LL_REPTAG_&InputLabel1 /]">
    
    <input type="hidden"
           name="InputLabel2"
           value="[LL_REPTAG_&InputLabel2 /]">
    </form>
</div>

<div class="report-header">

    <h2>Failed Documents - CLM Search Audit</h2>

    <p>
        Generated on:
        [LL_REPTAG_DATETIME /]
        |
        Total Records Found:
        [LL_REPTAG_INDEXTOTALHITS /]
    </p>

<div class="filter-info">
    Search Date Range:

    <b>[LL_REPTAG_&InputLabel1 SUBSTR:5:2 /]/[LL_REPTAG_&InputLabel1 SUBSTR:7:2 /]/[LL_REPTAG_&InputLabel1 SUBSTR:1:4 /]</b>

    →

    <b>[LL_REPTAG_&InputLabel2 SUBSTR:5:2 /]/[LL_REPTAG_&InputLabel2 SUBSTR:7:2 /]/[LL_REPTAG_&InputLabel2 SUBSTR:1:4 /]</b>
</div>

<button class="export-btn" type="button"
        onclick="exportToExcel()">
    Export Excel
</button>

</div>

<table id="reportTable">

    <thead>
        <tr>
            <th>OT-FileName</th>
            <th>OT-National ID</th>
            <th>OT-Site</th>
            <th>OT-Customer Name</th>
            <th>OT-Effective Date</th>
            <th>OT-Expiration Date</th>
            <th>OT-Modified Date</th>
            <th>OT-Data ID</th>
            <th>Failure Reason</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        [LL_WEBREPORT_STARTROW /]

        <tr>

            <td>[LL_REPTAG_4 /]</td>

            <td>
                [LL_REPTAG_2 CAT:'CLM Search':'National ID':DISPLAY /]
            </td>

            <td>
                [LL_REPTAG_2 CAT:'CLM Search':'Lead House - OpCo':DISPLAY /]
            </td>

            <td>
                [LL_REPTAG_2 CAT:'CLM Search':'Customer Name':DISPLAY /]
            </td>

            <td>
                [LL_REPTAG_2 CAT:'CLM Search':'Effective Date':DISPLAY /]
            </td>

            <td>
                [LL_REPTAG_2 CAT:'CLM Search':'Expiration Date':DISPLAY /]
            </td>

            <td>
                [LL_REPTAG=modifyDate /]
            </td>

            <td>
                <span class="doc-id">
                    [LL_REPTAG_2 /]
                </span>
            </td>
            
            <td>
                [LL_REPTAG_2 CAT:'CLMTracking':'MSA Pricing Status Note':DISPLAY /]
            </td>
            
            
            <td>
                <a class="action-link"
                   href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=properties"
                   target="_blank">
                    Properties
                </a>

                |

                <a class="action-link"
                   href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=view"
                   target="_blank">
                    View
                </a>
            </td>

        </tr>

        [LL_WEBREPORT_ENDROW /]

    </tbody>

</table>

<script>

function exportToExcel() {

    try {

        var table = document.getElementById("reportTable");

        if (!table) {
            alert("Table not found.");
            return;
        }

        var rows = [];
        var headers = [];

        var ths = table.getElementsByTagName("th");

        for (var i = 0; i < ths.length - 1; i++) {
            headers.push(ths[i].innerText || ths[i].textContent);
        }

        rows.push(headers);

        var trs = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr");

        for (var r = 0; r < trs.length; r++) {

            var row = [];
            var tds = trs[r].getElementsByTagName("td");

 

        for (var c = 0; c < tds.length - 1; c++) {
            row.push(
                (tds[c].innerText || tds[c].textContent).trim()
            );
        }

            if (row.length > 0) {
                rows.push(row);
            }
        }

        var wb = XLSX.utils.book_new();

        var ws = XLSX.utils.aoa_to_sheet(rows);

        var cols = [];

        for (var h = 0; h < headers.length; h++) {

            var max = headers[h].length;

            for (var rr = 0; rr < rows.length; rr++) {

                if (rows[rr][h]) {
                    max = Math.max(
                        max,
                        String(rows[rr][h]).length
                    );
                }
            }

            cols.push({
                wch: Math.min(max + 5, 60)
            });
        }

        ws["!cols"] = cols;

        XLSX.utils.book_append_sheet(
            wb,
            ws,
            "Failed Documents"
        );

        var d = new Date();

        var yyyy = d.getFullYear();
        var mm = ("0" + (d.getMonth() + 1)).slice(-2);
        var dd = ("0" + d.getDate()).slice(-2);

        var fileName =
            "Failed_Documents_" +
            yyyy + "-" + mm + "-" + dd +
            ".xlsx";

        XLSX.writeFile(wb, fileName);

    }
    catch (e) {
        alert(
            "Excel export failed : " +
            e.message
        );
    }
}
</script>

</body>
</html>