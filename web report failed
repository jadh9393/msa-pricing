[LL_WEBREPORT_EXCLUDEHTML /]
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Failed Documents - CLM Search Report</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 30px;
            background-color: #f4f6f9;
            color: #333;
        }
        .report-header {
            margin-bottom: 25px;
        }
        .report-header h2 {
            margin: 0 0 10px 0;
            color: #1a365d;
        }
        .report-header p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        th {
            background-color: #1a365d;
            color: #ffffff;
            text-align: left;
            padding: 14px 16px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
        }
        tr:last-child td {
            border-bottom: none;
        }
        tr:hover {
            background-color: #f8fafc;
        }
        .doc-id {
            font-family: monospace;
            font-weight: bold;
            color: #4a5568;
            background: #edf2f7;
            padding: 3px 6px;
            border-radius: 4px;
        }
        .action-link {
            color: #3182ce;
            text-decoration: none;
            font-weight: 600;
        }
        .action-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="report-header">
        <h2>Failed Documents - CLM Search Audit</h2>
        <p>Generated on: [LL_REPTAG_DATETIME /] | Total Records Found: [LL_REPTAG_INDEXTOTALHITS /]</p>
    </div>
    
    <table>
        <thead>
            <tr>
                <th>OT-FileName</th>
                <th>OT-National ID</th>
                <th>OT-Site</th>
                <th>OT-Customer Name</th>
                <th>OT-Effective Date</th>
                <th>OT-Expiration Date</th>
                <th>OT-Modified Date</th>
                <th>OT-Data ID</th>

                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            [LL_WEBREPORT_STARTROW /]
            <tr>
                <td>[LL_REPTAG_4 /]</span></td>

                <td>[LL_REPTAG_2 CAT:'CLM Search':'National ID':DISPLAY /]</td>
                
                <td>[LL_REPTAG_2 CAT:'CLM Search':'Lead House - OpCo':DISPLAY /]</td>

                <td>[LL_REPTAG_2 CAT:'CLM Search':'Customer Name':DISPLAY /]</td>

                <td>[LL_REPTAG_2 CAT:"CLM Search":"Effective Date":DISPLAY /]</td>

                <td>[LL_REPTAG_2 CAT:"CLM Search":"Expiration Date":DISPLAY /]</td>

                <td>[LL_REPTAG=modifyDate /]</td>

                <!-- Column 1: DataID -->
                <td><span class="doc-id">[LL_REPTAG_2 /]</span></td>


                <td>
                    <a class="action-link" href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=properties" target="_blank">Properties</a> | 
                    <a class="action-link" href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=view" target="_blank">View</a>
                </td>
            </tr>
            [LL_WEBREPORT_ENDROW /]
        </tbody>
    </table>


</body>
</html>