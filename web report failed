[LL_WEBREPORT_EXCLUDEHTML /]

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Failed Documents - CLM Search Report</title>

    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 30px;
            background-color: #f4f6f9;
            color: #333;
        }

        .report-header {
            margin-bottom: 25px;
        }

        .report-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
        }

        .report-header-text {
            min-width: 0;
        }

        .report-header h2 {
            margin: 0 0 10px 0;
            color: #1a365d;
        }

        .report-header p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }

        .filter-info {
            margin-top: 10px;
            font-size: 14px;
            color: #444;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        th {
            background-color: #1a365d;
            color: #ffffff;
            text-align: left;
            padding: 14px 16px;
            font-size: 14px;
            text-transform: uppercase;
        }

        td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
        }

        tr:hover {
            background-color: #f8fafc;
        }

        .doc-id {
            font-family: monospace;
            font-weight: bold;
            color: #4a5568;
            background: #edf2f7;
            padding: 3px 6px;
            border-radius: 4px;
        }

        .action-link {
            color: #3182ce;
            text-decoration: none;
            font-weight: 600;
        }

        .action-link:hover {
            text-decoration: underline;
        }

        .search-again {
            margin-bottom: 20px;
        }

        .search-again button {
            background: #1a365d;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .search-again button:hover {
            background: #153052;
            transform: translateY(-1px);
        }

        .search-again button:focus-visible {
            outline: 2px solid #1a365d;
            outline-offset: 2px;
        }

        .export-btn {
            background: #2f855a;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            margin-left: 0;
            font-weight: 600;
            white-space: nowrap;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .export-btn:hover {
            background: #276749;
            transform: translateY(-1px);
        }

        .export-btn:focus-visible {
            outline: 2px solid #2f855a;
            outline-offset: 2px;
        }

        @media (max-width: 768px) {
            .report-header-bar {
                flex-direction: column;
                align-items: flex-start;
            }

            .export-btn {
                margin-top: 8px;
            }
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

</head>

<body>

    <div class="search-again">
        <form method="GET" action="cs.exe">

            <input type="hidden" name="func" value="ll">

            <input type="hidden" name="objId" value="35950584">

            <input type="hidden" name="objAction" value="RunReport">

            <button type="submit">
                Change Date Filter
            </button>

            <input type="hidden" name="InputLabel1" value="[LL_REPTAG_&InputLabel1 /]">

            <input type="hidden" name="InputLabel2" value="[LL_REPTAG_&InputLabel2 /]">
        </form>
    </div>

    <div class="report-header">
        <div class="report-header-bar">
            <div class="report-header-text">
                <h2>Unprocessed Documents</h2>

                <div class="filter-info">
                    Search Date Range:

                    <b>[LL_REPTAG_&InputLabel1 SUBSTR:5:2 /]/[LL_REPTAG_&InputLabel1 SUBSTR:7:2 /]/[LL_REPTAG_&InputLabel1
                        SUBSTR:1:4 /]</b>

                    →

                    <b>[LL_REPTAG_&InputLabel2 SUBSTR:5:2 /]/[LL_REPTAG_&InputLabel2 SUBSTR:7:2 /]/[LL_REPTAG_&InputLabel2
                        SUBSTR:1:4 /]</b>
                    </br>
                    Total Records Found: <b>[LL_REPTAG_INDEXTOTALHITS /]</b>
                </div>
            </div>

            <button class="export-btn" type="button" onclick="exportToExcel()">
                Export Excel
            </button>
        </div>
    </div>

    <table id="reportTable">

        <thead>
            <tr>
                <th>OT-FileName</th>
                <th>OT-National ID</th>
                <th>OT-Site</th>
                <th>OT-Customer Name</th>
                <th>OT-Effective Date</th>
                <th>OT-Expiration Date</th>
                <th>OT-Modified Date</th>
                <th>OT-Data ID</th>
                <th>Unprocessed Reason</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            [LL_WEBREPORT_STARTROW /]

            <tr>

                <td>[LL_REPTAG_4 /]</td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'National ID':DISPLAY /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Lead House - OpCo':DISPLAY /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Customer Name':DISPLAY /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Effective Date':DISPLAY DATE:'%m/%d/%Y' /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Expiration Date':DISPLAY DATE:'%m/%d/%Y' /]
                </td>

                <td>
                    [LL_REPTAG=modifyDate DATE:'%m/%d/%Y' /]
                </td>

                <td>
                    <span class="doc-id">
                        [LL_REPTAG_2 /]
                    </span>
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLMTracking':'MSA Pricing Status Note':DISPLAY /]
                </td>


                <td>
                    <a class="action-link" href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=properties"
                        target="_blank">
                        Properties
                    </a>

                    |

                    <a class="action-link" href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=view" target="_blank">
                        View
                    </a>
                </td>

            </tr>

            [LL_WEBREPORT_ENDROW /]

        </tbody>

    </table>

    <script>

        function exportToExcel() {

            try {

                const reportTableElement = document.getElementById("reportTable");

                if (!reportTableElement) {
                    alert("Table not found.");
                    return;
                }

                const worksheetRows = [];
                const headerRow = [];

                const headerCells = reportTableElement.getElementsByTagName("th");

                for (let headerIndex = 0; headerIndex < headerCells.length - 1; headerIndex++) {
                    headerRow.push(headerCells[headerIndex].innerText || headerCells[headerIndex].textContent);
                }

                worksheetRows.push(headerRow);

                const tableBody = reportTableElement.getElementsByTagName("tbody")[0];
                const bodyRows = tableBody.getElementsByTagName("tr");

                for (let bodyRowIndex = 0; bodyRowIndex < bodyRows.length; bodyRowIndex++) {

                    const currentRowValues = [];
                    const dataCells = bodyRows[bodyRowIndex].getElementsByTagName("td");


                    for (let dataCellIndex = 0; dataCellIndex < dataCells.length - 1; dataCellIndex++) {

                        currentRowValues.push(
                            (dataCells[dataCellIndex].innerText || dataCells[dataCellIndex].textContent).trim()
                        );
                    }

                    if (currentRowValues.length > 0) {
                        worksheetRows.push(currentRowValues);
                    }
                }

                const workbook = XLSX.utils.book_new();

                const worksheet = XLSX.utils.aoa_to_sheet(worksheetRows);

                const columnWidths = [];

                for (let columnIndex = 0; columnIndex < headerRow.length; columnIndex++) {

                    let maxColumnWidth = headerRow[columnIndex].length;

                    for (let worksheetRowIndex = 0; worksheetRowIndex < worksheetRows.length; worksheetRowIndex++) {

                        if (worksheetRows[worksheetRowIndex][columnIndex]) {
                            maxColumnWidth = Math.max(
                                maxColumnWidth,
                                String(worksheetRows[worksheetRowIndex][columnIndex]).length
                            );
                        }
                    }

                    columnWidths.push({
                        wch: Math.min(maxColumnWidth + 5, 60)
                    });
                }

                worksheet["!cols"] = columnWidths;

                XLSX.utils.book_append_sheet(
                    workbook,
                    worksheet,
                    "Failed Documents"
                );

                const currentDate = new Date();

                const year = currentDate.getFullYear();
                const month = ("0" + (currentDate.getMonth() + 1)).slice(-2);
                const day = ("0" + currentDate.getDate()).slice(-2);

                const exportFileName =
                    "Failed_Documents_" +
                    year + "-" + month + "-" + day +
                    ".xlsx";

                XLSX.writeFile(workbook, exportFileName);

            }
            catch (e) {
                alert(
                    "Excel export failed : " +
                    e.message
                );
            }
        }
    </script>

</body>

</html>