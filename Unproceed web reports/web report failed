[LL_WEBREPORT_EXCLUDEHTML /]

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>MSA Pricing - Unprocessed Documents Report</title>

    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 30px;
            background-color: #f4f6f9;
            color: #333;
        }

        .report-header {
            margin-bottom: 25px;
        }

        .report-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
        }

        .report-header-text {
            min-width: 0;
        }

        .report-header h2 {
            margin: 0 0 10px 0;
            color: #1a365d;
        }

        .report-header p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }

        .filter-info {
            margin-top: 10px;
            font-size: 14px;
            color: #444;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        th {
            background-color: #1a365d;
            color: #ffffff;
            text-align: left;
            padding: 14px 16px;
            font-size: 14px;
            text-transform: uppercase;
        }

        td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
        }

        tr:hover {
            background-color: #f8fafc;
        }

        .doc-id {
            font-family: monospace;
            font-weight: bold;
            color: #4a5568;
            background: #edf2f7;
            padding: 3px 6px;
            border-radius: 4px;
        }

        .action-link {
            color: #3182ce;
            text-decoration: none;
            font-weight: 600;
        }

        .action-link:hover {
            text-decoration: underline;
        }

        .search-again {
            margin-bottom: 20px;
        }

        .search-again button {
            background: #1a365d;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .search-again button:hover {
            background: #153052;
            transform: translateY(-1px);
        }

        .search-again button:focus-visible {
            outline: 2px solid #1a365d;
            outline-offset: 2px;
        }

        .export-btn {
            background: #2f855a;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            margin-left: 0;
            font-weight: 600;
            white-space: nowrap;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .export-btn:hover {
            background: #276749;
            transform: translateY(-1px);
        }

        .export-btn:focus-visible {
            outline: 2px solid #2f855a;
            outline-offset: 2px;
        }

        .pagination-container {
            margin-top: 25px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .pagination-btn {
            padding: 8px 12px;
            border: 1px solid #cbd5e0;
            background: white;
            color: #1a365d;
            border-radius: 4px;
            cursor: pointer;
            min-width: 40px;
            font-weight: 600;
        }

        .pagination-btn:hover {
            background: #edf2f7;
        }

        .pagination-btn.active {
            background: #1a365d;
            color: white;
            border-color: #1a365d;
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .pagination-summary {
            margin-top: 15px;
            text-align: center;
            color: #555;
            font-size: 14px;
        }

        @media (max-width: 768px) {
            .report-header-bar {
                flex-direction: column;
                align-items: flex-start;
            }

            .export-btn {
                margin-top: 8px;
            }
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.18.1/axios.min.js"></script>

</head>

<body>

    <div class="search-again">
        <form method="GET" action="cs.exe">

            <input type="hidden" name="func" value="ll">

            <input type="hidden" name="objId" value="[LL_REPTAG_&FilterWebReportId /]">

            <input type="hidden" name="objAction" value="RunReport">

            <button type="submit">
                Change Date Filter
            </button>

            <input type="hidden" name="InputLabel1" value="[LL_REPTAG_&InputLabel1 /]">

            <input type="hidden" name="InputLabel2" value="[LL_REPTAG_&InputLabel2 /]">
        </form>
    </div>

    <div class="report-header">
        <div class="report-header-bar">
            <div class="report-header-text">
                <h2>MSA Pricing - Unprocessed Documents</h2>

                <div class="filter-info">
                    Search Date Range:

                    <b>[LL_REPTAG_&InputLabel1 SUBSTR:5:2 /]/[LL_REPTAG_&InputLabel1 SUBSTR:7:2
                        /]/[LL_REPTAG_&InputLabel1
                        SUBSTR:1:4 /]</b>

                    →

                    <b>[LL_REPTAG_&InputLabel2 SUBSTR:5:2 /]/[LL_REPTAG_&InputLabel2 SUBSTR:7:2
                        /]/[LL_REPTAG_&InputLabel2
                        SUBSTR:1:4 /]</b>
                </div>
            </div>

            <button id="exportBtn" class="export-btn" type="button" onclick="exportToExcel()">
                Export Excel
            </button>
        </div>
    </div>

    <table id="reportTable">

        <thead>
            <tr>
                <th>OT-FileName</th>
                <th>OT-National ID</th>
                <th>OT-Site</th>
                <th>OT-Customer Name</th>
                <th>OT-Effective Date</th>
                <th>OT-Expiration Date</th>
                <th>OT-Modified Date</th>
                <th>OT-Data ID</th>
                <th>Unprocessed Reason</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            [LL_WEBREPORT_STARTROW /]

            <tr>

                <td>[LL_REPTAG_4 /]</td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'National ID':DISPLAY /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Lead House - OpCo':DISPLAY /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Customer Name':DISPLAY /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Effective Date':DISPLAY DATE:'%m/%d/%Y' /]
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLM Search':'Expiration Date':DISPLAY DATE:'%m/%d/%Y' /]
                </td>

                <td>
                    [LL_REPTAG=modifyDate DATE:'%m/%d/%Y' /]
                </td>

                <td>
                    <span class="doc-id">
                        [LL_REPTAG_2 /]
                    </span>
                </td>

                <td>
                    [LL_REPTAG_2 CAT:'CLMTracking':'MSA Pricing Status Note':DISPLAY /]
                </td>


                <td>
                    <a class="action-link" href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=properties"
                        target="_blank">
                        Properties
                    </a>

                    |

                    <a class="action-link" href="cs.exe?func=ll&objId=[LL_REPTAG_2 /]&objAction=view" target="_blank">
                        View
                    </a>
                </td>

            </tr>

            [LL_WEBREPORT_ENDROW /]

        </tbody>

    </table>
    <div class="pagination-summary" id="paginationSummary"></div>

    <div id="paginationContainer" class="pagination-container">
    </div>
    <script>
        (function () {

            var totalRows =
                parseInt(
                    "[LL_REPTAG_INDEXTOTALHITS /]"
                ) || 0;

            if (totalRows <= 300)
                return;

            var pageSize = 300;

            var params =
                new URLSearchParams(
                    window.location.search
                );

            var currentPage =
                parseInt(new URLSearchParams(window.location.search).get("page")) || 1;

            var totalPages =
                Math.ceil(
                    totalRows / pageSize
                );

            var container =
                document.getElementById(
                    "paginationContainer"
                );

            var summary =
                document.getElementById(
                    "paginationSummary"
                );

            var start =
                ((currentPage - 1) * pageSize) + 1;

            var end =
                Math.min(
                    currentPage * pageSize,
                    totalRows
                );

            summary.innerHTML =
                "Showing " +
                start +
                " - " +
                end +
                " of " +
                ~ totalRows +
                " documents";

            function gotoPage(page) {

                var startFormatted =
                    "[LL_REPTAG_&InputLabel1 /]";

                var endFormatted =
                    "[LL_REPTAG_&InputLabel2 /]";

                var startAt =
                    ((page - 1) * 300) + 1;

                window.location.href =
                    "cs.exe"
                    + "?func=ll"
                    + "&objId=[LL_REPTAG_&objId /]"
                    + "&objAction=RunReport"
                    + "&page=" + page
                    + "&startAt=" + startAt
                    + "&InputLabel1="
                    + encodeURIComponent(
                        startFormatted
                    )
                    + "&InputLabel2="
                    + encodeURIComponent(
                        endFormatted
                    );
            }

            function addButton(
                label,
                page,
                active,
                disabled
            ) {

                var btn =
                    document.createElement(
                        "button"
                    );

                btn.className =
                    "pagination-btn";

                btn.innerText =
                    label;

                if (active)
                    btn.classList.add(
                        "active"
                    );

                if (disabled)
                    btn.disabled = true;

                btn.onclick =
                    function () {
                        gotoPage(page);
                    };

                container.appendChild(
                    btn
                );
            }

            addButton(
                "«",
                currentPage - 1,
                false,
                currentPage === 1
            );

            var startPage =
                Math.max(
                    1,
                    currentPage - 2
                );

            var endPage =
                Math.min(
                    totalPages,
                    currentPage + 2
                );

            if (startPage > 1) {

                addButton(
                    "1",
                    1
                );

                if (startPage > 2) {

                    var dots =
                        document.createElement(
                            "span"
                        );

                    dots.innerHTML = "...";

                    container.appendChild(
                        dots
                    );
                }
            }

            for (
                var i = startPage;
                i <= endPage;
                i++
            ) {

                addButton(
                    i,
                    i,
                    i === currentPage
                );
            }

            if (
                endPage <
                totalPages
            ) {

                if (
                    endPage <
                    totalPages - 1
                ) {

                    var dots2 =
                        document.createElement(
                            "span"
                        );

                    dots2.innerHTML =
                        "...";

                    container.appendChild(
                        dots2
                    );
                }

                addButton(
                    totalPages,
                    totalPages
                );
            }

            addButton(
                "»",
                currentPage + 1,
                false,
                currentPage === totalPages
            );

        })();
        function exportToExcel() {

            var exportBtn =
                document.getElementById("exportBtn");

            if (typeof XLSX === "undefined") {
                alert("XLSX library not loaded.");
                return;
            }

            if (typeof axios === "undefined") {
                alert("Axios library not loaded.");
                return;
            }

            exportBtn.disabled = true;
            exportBtn.innerText = "Preparing export...";

            var startDate =
                "[LL_REPTAG_&InputLabel1 /]";

            var endDate =
                "[LL_REPTAG_&InputLabel2 /]";

            var allRows = [];

            var startAt = 1;
            var page = 1;

            /*
                Highest TOTALSOURCEROWS seen.
                Search counts can shrink on later pages.
            */
            var expectedRows = 0;

            /*
                Used to detect the last page.
            */
            var previousActualRows = null;

            function resetButton() {
                exportBtn.disabled = false;
                exportBtn.innerText = "Export Excel";
            }

            function fail(message) {
                resetButton();
                alert(message);
            }

            function finishExport() {

                exportBtn.innerText =
                    "Generating Excel...";

                createExcel(allRows);

                resetButton();
            }

            function fetchPage() {

                var url =
                    "cs.exe?func=ll" +
                    "&objId=[LL_REPTAG_&JsonDataWebReportId /]" +
                    "&objAction=RunReport" +
                    "&page=" + page +
                    "&startAt=" + startAt +
                    "&InputLabel1=" +
                    encodeURIComponent(startDate) +
                    "&InputLabel2=" +
                    encodeURIComponent(endDate);

                axios
                    .get(url, {
                        headers: {
                            "Accept": "application/json"
                        }
                    })
                    .then(function (response) {

                        var json =
                            response.data;

                        if (
                            !json ||
                            typeof json !== "object"
                        ) {
                            fail(
                                "Invalid response."
                            );
                            return;
                        }

                        var pageRows =
                            Array.isArray(
                                json.myRows
                            )
                                ? json.myRows
                                : [];

                        var actualRows =
                            Number(
                                json.actualRows
                            ) || 0;

                        var filteredRows =
                            Number(
                                json.filteredRows
                            ) || 0;

                        /*
                            Keep highest count seen.
                        */
                        expectedRows =
                            Math.max(
                                expectedRows,
                                filteredRows
                            );

                        if (
                            pageRows.length > 0
                        ) {
                            allRows =
                                allRows.concat(
                                    pageRows
                                );
                        }

                        /*
                            Show percentage instead
                            of row count.
                        */
                        if (
                            expectedRows > 0
                        ) {

                            var percentage =
                                Math.min(
                                    100,
                                    Math.round(
                                        (
                                            allRows.length *
                                            100
                                        ) /
                                        expectedRows
                                    )
                                );

                            exportBtn.innerText =
                                "Exporting... " +
                                percentage +
                                "%";
                        }
                        else {

                            exportBtn.innerText =
                                "Exporting...";
                        }

                        /*
                         =====================================
                         STOP CONDITIONS
                         =====================================
                        */

                        /*
                            Empty page.
                        */
                        if (
                            pageRows.length === 0
                        ) {
                            finishExport();
                            return;
                        }

                        /*
                            We received less rows than
                            previous page.
                            Usually means last page.
                        */
                        if (
                            previousActualRows !== null &&
                            actualRows <
                            previousActualRows
                        ) {
                            finishExport();
                            return;
                        }

                        /*
                            Safety check.
                        */
                        if (
                            expectedRows > 0 &&
                            allRows.length >=
                            expectedRows
                        ) {
                            finishExport();
                            return;
                        }

                        /*
                            Another safety check.
                            Sometimes actualRows can
                            become zero unexpectedly.
                        */
                        if (
                            actualRows <= 0
                        ) {
                            finishExport();
                            return;
                        }

                        previousActualRows =
                            actualRows;

                        startAt =
                            startAt +
                            actualRows;

                        page++;

                        fetchPage();

                    })
                    .catch(function (error) {
                        fail(
                            "Export failed while retrieving pages."
                        );
                    });
            }

            fetchPage();
        }

        function createExcel(rows) {

            var sheetRows = [];

            sheetRows.push([
                "OT-FileName",
                "OT-National ID",
                "OT-Site",
                "OT-Customer Name",
                "OT-Effective Date",
                "OT-Expiration Date",
                "OT-Modified Date",
                "OT-Data ID",
                "Unprocessed Reason"
            ]);

            for (
                var i = 0;
                i < rows.length;
                i++
            ) {

                sheetRows.push([
                    rows[i].OTFileName,
                    rows[i].OTNationalId,
                    rows[i].OTSite,
                    rows[i].OTCustomerName,
                    rows[i].OTEffectiveDate,
                    rows[i].OTExpirationDate,
                    rows[i].OTModifiedDate,
                    rows[i].OTDataId,
                    rows[i].UnprocessedReason
                ]);
            }

            var wb =
                XLSX.utils.book_new();

            var ws =
                XLSX.utils.aoa_to_sheet(
                    sheetRows
                );

            XLSX.utils.book_append_sheet(
                wb,
                ws,
                "Unprocessed Documents"
            );

            XLSX.writeFile(
                wb,
                "Unprocessed_Documents.xlsx"
            );
        }
    </script>

</body>

</html>